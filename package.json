{
	"name": "busybar",
	"version": "0.0.0",
	"description": "A tool for interfacing with a BUSY Bar",
	"private": true,
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"build": "npm run cleanup && npm run build:node",
		"build:node": "tsc -p tsconfig.build.json",
		"cleanup": "rimraf dist",
		"dev": "node --watch src/index.ts",
		"format": "npm run format:eslint && npm run format:prettier",
		"format:eslint": "eslint ./src --fix || true",
		"format:prettier": "prettier . --write",
		"lint": "npm run lint:eslint && npm run lint:prettier && npm run lint:tsc",
		"lint:eslint": "eslint ./src --max-warnings=0",
		"lint:prettier": "prettier . --check",
		"lint:tsc": "tsc --noEmit -p tsconfig.json",
		"start": "node dist/index.js",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/slifty/busybar.git"
	},
	"keywords": [
		"busy",
		"busy-bar",
		"pomodoro",
		"status"
	],
	"author": "Daniel Schultz",
	"license": "AGPL-3.0",
	"engines": {
		"node": "24"
	},
	"devDependencies": {
		"@biffud/eslint-config": "~10.27.0",
		"@tsconfig/node24": "^24.0.5",
		"@types/node": "^24.13.6",
		"@vitest/coverage-v8": "^5.0.1",
		"eslint": "^10.12.0",
		"prettier": "3.9.9",
		"rimraf": "^6.1.3",
		"typescript": "^6.0.3",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"@busy-app/busy-lib": "^0.21.1",
		"@pdc/http-status-codes": "^1.0.1",
		"ical.js": "^2.2.1",
		"yaml": "^2.9.1"
	}
}
