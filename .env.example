# Copy to .env and edit. Everything here is optional -- the defaults shown are
# what the tool uses when a variable is unset.
#
#     cp .env.example .env
#
# .env is git-ignored; this file is not. Add a block here whenever a program
# gains a setting, so there is one place to discover what can be configured.

# ── Core ──────────────────────────────────────────────────────────────────────

# Which program to run. `npm run dev` with no value runs hello-world.
# One of: focus, hello-world, random-emoji
BUSYBAR_PROGRAM=hello-world

# ── focus ─────────────────────────────────────────────────────────────────────

# An iCalendar feed to read focus blocks from -- either an https URL or a path
# to an .ics file. Unset by default, which falls back to BUSYBAR_FOCUS_FILE
# below; setting it takes precedence over that file.
#
# In Google Calendar, both come from Settings for the calendar in question:
# "Secret address in iCal format" is the URL, and "Export calendar" downloads a
# zip with an .ics inside it. The URL keeps up with edits on its own; a
# downloaded file is a snapshot and goes stale, so prefer the URL unless you
# have a reason not to. Anyone holding the secret address can read the calendar,
# so it belongs in .env rather than anywhere committed.
#
# BUSYBAR_FOCUS_CALENDAR=https://calendar.google.com/calendar/ical/…/basic.ics
# BUSYBAR_FOCUS_CALENDAR=local/focus.ics

# Where the focus schedule is read from when no calendar is set, relative to the
# working directory. Hand-written JSON -- the quickest way to try something
# without exporting anything.
# `local/` is git-ignored, which is why the schedule lives there by default.
BUSYBAR_FOCUS_FILE=local/focus.json
